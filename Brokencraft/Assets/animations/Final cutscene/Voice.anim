    intParameter: 0
    messageOptions: 0
  - time: 20.25
    functionName: Say
    data: It seems You must be told the truth
    objectReferenceParameter: {fileID: 0}
    floatParameter: 0
    intParameter: 0
    messageOptions: 0
  - time: 24.183332
    functionName: Say
    data: We created the universe
